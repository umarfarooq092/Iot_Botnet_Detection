# Backend environment example

APP_NAME=SSD Assignment 3 API
ENVIRONMENT=development
PORT=8000

# Comma-separated allowed frontend origins
CORS_ORIGIN=https://localhost:5173,https://127.0.0.1:5173

REQUEST_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120

# Use 32+ chars in non-dev environments
JWT_SECRET=replace-with-a-strong-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m

# SQLite default
DATABASE_URL=sqlite:///data/ssd_app.db

# Data protection keys (32+ chars each)
DATA_ENCRYPTION_KEY=replace-with-a-strong-data-encryption-key-at-least-32-characters
DB_ENCRYPTION_KEY=replace-with-a-strong-database-encryption-key-at-least-32-characters

# Google OAuth2/OIDC
SSO_ENABLED=true
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://localhost:8000/api/v1/auth/sso/google/callback
FRONTEND_URL=https://localhost:5173

# Development TLS (HTTPS)
TLS_ENABLED=true
TLS_CERTFILE=certs/dev-cert.pem
TLS_KEYFILE=certs/dev-key.pem

# Demo credentials and device defaults
DEMO_ADMIN_USERNAME=your-admin-username
DEMO_ADMIN_PASSWORD=your-strong-demo-admin-password
DEMO_DEVICE_ID=your-demo-device-id
DEMO_DEVICE_API_KEY=your-demo-device-api-key
